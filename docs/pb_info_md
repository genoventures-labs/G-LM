## Usage Examples

### Creating a Tenant with Full Setup

```typescript
import PocketBase from 'pocketbase';

const pb = new PocketBase('https://pocketbase.thynaptic.com');

// Authenticate as commander
await pb.collection('users').authWithPassword('admin@example.com', 'password');

// 1. Create tenant
const tenant = await pb.collection('tenants').create({
  name: 'Acme Corp',
  status: 'active'
});

// 2. Create model policy
await pb.collection('model_policies').create({
  tenant_id: tenant.id,
  allowed_models: ['gpt-4', 'gpt-3.5-turbo'],
  primary_model: 'gpt-4',
  fallback_model: 'gpt-3.5-turbo',
  reasoning_visible: false
});

// 3. Create quotas
await pb.collection('quotas').create({
  tenant_id: tenant.id,
  rpm_limit: 60,
  tpm_limit: 90000,
  burst: 10
});

// 4. Create API key
await pb.collection('api_keys').create({
  tenant_id: tenant.id,
  prefix: 'sk_live_',
  hash: 'hashed_value_here',
  scopes: ['read', 'write'],
  status: 'active',
  expires_at: '2027-12-31T23:59:59Z'
});

// 5. Create roles
const adminRole = await pb.collection('roles').create({
  tenant_id: tenant.id,
  name: 'admin',
  permissions: ['read', 'write', 'delete', 'admin']
});

// 6. Create membership
await pb.collection('memberships').create({
  tenant_id: tenant.id,
  principal_id: 'user_12345',
  role_id: adminRole.id
});

console.log('✅ Tenant fully configured');
```

